{
  "name": "grid-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:server\" \"npm:web\"",
    "web": "vite",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "codegen": "graphql-codegen --config codegen.yml",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.6",
    "mapbox-gl": "^3.7.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/d3": "^7.4.3",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.0",
    "tslib": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
