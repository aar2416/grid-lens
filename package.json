{
  "name": "grid-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:server\" \"npm:web\"",
    "web": "vite",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.6",
    "mapbox-gl": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/d3": "^7.4.3",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.5",
    "tslib": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
